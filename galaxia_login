# Galaxia para el log in (versión para usarse dentro de un tk.Canvas) #
import random, colorsys, math, time
import tkinter as tk


def iniciar_galaxia(lienzo, ancho=400, alto=450):
    """Dibuja y anima la galaxia dentro de `lienzo` (un tk.Canvas de ancho x alto)."""

    azar = random.Random(3)   # azar propio para el titileo (no altera tu galaxia)
    TILT = 0.45
    LOTE = 25        # puntos nuevos por cuadro: más bajo = se forma más lento
    PAUSA = 0.005    # pausa extra entre cuadros al formarse
    VEL = 0.35       # velocidad de giro (radianes por segundo)
    ESCALA = ancho / 780   # encoge la galaxia original (780 px de ancho) para que quepa en el panel
    INTERVALO = 33   # ms entre cuadros al girar (33 = unos 30 cuadros por segundo; más alto = menos CPU)
    N_POLVO = 300        # antes 700
    N_BRAZOS = 100       # antes 900 (cada uno dibuja 4 puntos)
    N_NUCLEO = 120       # antes 260
    N_DESTELLOS = 100    # antes 260
    contador = 0
    angulo = 0
    puntos = []      # puntos que giran: (id, x, y, radio)
    estrellitas = [] # estrellas que titilan: (id, frecuencia, fase)
    inicio = time.time()

    # El (0, 0) queda en el centro del lienzo, igual que en turtle
    lienzo.configure(bg="#03030b", highlightthickness=0,
                     scrollregion=(-ancho / 2, -alto / 2, ancho / 2, alto / 2))

    def a_hex(c):
        if isinstance(c, str):
            return c
        return "#%02x%02x%02x" % tuple(int(v * 255) for v in c)

    def brillo(h, v=0):
        return colorsys.hsv_to_rgb(h % 1, 0.7, v)

    def lugar(x, y):
        ca, sa = math.cos(angulo), math.sin(angulo)
        x, y = x * ca - y * sa, x * sa + y * ca     # giro
        y *= 0.55
        c, s = math.cos(TILT), math.sin(TILT)
        return (x * c - y * s) * ESCALA, (x * s + y * c) * ESCALA

    def fotograma():
        nonlocal angulo
        t = time.time() - inicio
        angulo = -t * VEL
        ca, sa = math.cos(angulo), math.sin(angulo)
        c, s = math.cos(TILT), math.sin(TILT)
        for ident, x, y, r in puntos:
            xr = x * ca - y * sa
            yr = (x * sa + y * ca) * 0.55
            X = (xr * c - yr * s) * ESCALA
            Y = (xr * s + yr * c) * ESCALA
            lienzo.coords(ident, X - r, -Y - r, X + r, -Y + r)
        for ident, f, p in estrellitas:             # titileo: se apagan y se encienden
            b = max(0, math.sin(t * f + p)) ** 2
            col = "#%02x%02x%02x" % (int(3 + 252 * b), int(3 + 252 * b), int(11 + 244 * b))
            lienzo.itemconfig(ident, fill=col)

    def refrescar():
        nonlocal contador
        contador += 1
        if contador % LOTE == 0:
            fotograma()
            lienzo.update()      # deja que se vea cómo se va formando
            time.sleep(PAUSA)

    def punto(x, y, d, color):
        X, Y = lugar(x, y)
        r = d / 2
        ident = lienzo.create_oval(X - r, -Y - r, X + r, -Y + r,
                                   fill=a_hex(color), outline="")
        puntos.append((ident, x, y, r))
        refrescar()

    def estrellas():
        for _ in range(140):
            x = random.randint(-ancho // 2, ancho // 2)
            y = random.randint(-alto // 2, alto // 2)
            d = random.randint(1, 3)
            ident = lienzo.create_oval(x - d / 2, -y - d / 2, x + d / 2, -y + d / 2,
                                       fill="#03030b", outline="")
            estrellitas.append((ident, azar.uniform(1.5, 4), azar.uniform(0, 6.283)))
            refrescar()

    def polvo():
        for _ in range(N_POLVO):
            r = random.gauss(0, 120)
            a = random.uniform(0, 6.283)
            punto(r * math.cos(a), r * math.sin(a),
                  random.randint(2, 4), brillo(0.7, 0.3))

    def brazos(conteo):
        for i in range(conteo):
            for j in range(4):
                d = i / conteo
                a = j * math.pi / 2 + d * 5.5
                r = 10 + d * 290
                s = 4 + d * 26
                x = r * math.cos(a) + random.gauss(0, s)
                y = r * math.sin(a) + random.gauss(0, s)
                hue = 0.13 - d * 0.55
                v = random.uniform(0.6, 1)
                tamaño = random.randint(2, 4)
                punto(x, y, tamaño, brillo(hue, v))

    def nucleo():
        for _ in range(N_NUCLEO):
            r = random.gauss(0, 150)
            a = random.uniform(0, 6.283)
            punto(r * math.cos(a), r * math.sin(a),
                  random.randint(2, 5), brillo(0.12, 0.9))

    def destellos():
        for _ in range(N_DESTELLOS):
            r = random.gauss(0, 150)
            a = random.uniform(0, 6.283)
            punto(r * math.cos(a), r * math.sin(a),
                  random.randint(5, 8), "white")

    def girar():
        try:
            fotograma()
        except tk.TclError:      # la ventana ya se cerró
            return
        lienzo.after(INTERVALO, girar)

    def construir():
        # random.seed(7) cambiaría el random de TODO el programa (incluido el generador
        # de contraseñas), así que guardamos su estado y lo restauramos al terminar.
        estado_random = random.getstate()
        random.seed(7)
        try:
            estrellas()
            polvo()
            brazos(N_BRAZOS)
            nucleo()
            destellos()
            lienzo.create_oval(-13, -13, 13, 13, fill="#fff3c4", outline="")
            girar()
        except tk.TclError:
            pass                 # se cerró la ventana mientras se formaba la galaxia
        finally:
            random.setstate(estado_random)

    lienzo.after(100, construir)  # primero aparece la ventana y luego se forma la galaxia
